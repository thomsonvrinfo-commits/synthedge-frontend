{
  "name": "PaymentRecord",
  "type": "object",
  "properties": {
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "method": {
      "type": "string",
      "enum": [
        "stripe",
        "ecocash",
        "paynow",
        "free"
      ]
    },
    "transaction_reference": {
      "type": "string",
      "description": "Payment reference (EcoCash or Paynow)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    },
    "plan": {
      "type": "string",
      "enum": [
        "pro"
      ],
      "default": "pro"
    },
    "billing_cycle": {
      "type": "string",
      "enum": [
        "monthly",
        "annual"
      ]
    },
    "notes": {
      "type": "string"
    },
    "poll_url": {
      "type": "string",
      "description": "Paynow poll URL for manual status checking"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "amount",
    "method",
    "plan"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}