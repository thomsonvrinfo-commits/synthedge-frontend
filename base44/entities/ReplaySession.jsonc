{
  "name": "ReplaySession",
  "type": "object",
  "properties": {
    "index_name": {
      "type": "string",
      "description": "e.g. Volatility 75"
    },
    "granularity": {
      "type": "number",
      "description": "Candle size in seconds"
    },
    "visible_count": {
      "type": "number",
      "description": "Replay position (how many candles revealed)"
    },
    "candle_start_epoch": {
      "type": "number",
      "description": "Epoch of first candle in session"
    },
    "drawings": {
      "type": "array",
      "description": "Serialized chart drawing objects",
      "items": {
        "type": "object"
      }
    },
    "session_trades": {
      "type": "array",
      "description": "Trades placed during this replay session",
      "items": {
        "type": "object"
      }
    },
    "stats": {
      "type": "object",
      "description": "Session-level stats snapshot"
    },
    "name": {
      "type": "string",
      "description": "Session label"
    },
    "completed": {
      "type": "boolean",
      "default": false
    },
    "objective": {
      "type": "string",
      "description": "Research session objective/goal"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "completed"
      ],
      "default": "active"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "strategy_name": {
      "type": "string",
      "description": "Trading strategy being tested"
    },
    "rules_being_tested": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Trading rules being tested in this session"
    },
    "notes": {
      "type": "string",
      "description": "Session notes and observations"
    },
    "conclusion": {
      "type": "string",
      "description": "Final conclusion after session completion"
    }
  },
  "required": [
    "index_name",
    "granularity"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}