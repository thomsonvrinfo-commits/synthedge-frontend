{
  "name": "TradingRule",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Short rule name"
    },
    "description": {
      "type": "string",
      "description": "Full rule description"
    },
    "category": {
      "type": "string",
      "enum": [
        "Risk Management",
        "Entry Rules",
        "Exit Rules",
        "Session Rules",
        "Psychology",
        "Trade Management"
      ],
      "description": "Rule category"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "violation_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title",
    "category"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}