{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "types": ["node", "@cloudflare/workers-types", "vitest/globals"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@synthedge/shared": ["../shared/src/index.ts"],
      "@synthedge/shared/*": ["../shared/src/*"]
    }
  },
  "include": ["src/test-utils/**/*.ts", "src/**/*.integration.test.ts", "../shared/src"]
}
